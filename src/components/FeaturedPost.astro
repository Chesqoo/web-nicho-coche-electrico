---
// Artículo destacado de portada: rompe la cuadrícula uniforme con una
// pieza más grande y editorial en vez de otra tarjeta idéntica más.
import { SITE, categoriaDe } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const cat = categoriaDe(post.data.tags);
const fmt = new Intl.DateTimeFormat(SITE.idioma, { dateStyle: 'long' });
---
<article class="destacado">
  <div class="destacado-texto">
    <span class="etiqueta-destacado">Destacado{cat && ` · ${cat.nombre}`}</span>
    <h2><a href={`/${post.id}/`}>{post.data.title}</a></h2>
    <p class="desc">{post.data.description}</p>
  </div>
  <div class="destacado-meta">
    <span class="meta">{fmt.format(post.data.pubDate)}</span>
    <a class="card-cta" href={`/${post.id}/`}>{SITE.textoCta}</a>
  </div>
</article>

<style>
  .destacado {
    display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem;
    justify-content: space-between; align-items: flex-start;
    background: var(--card); border: 1px solid var(--borde); border-radius: var(--radius);
    padding: 2rem; margin-top: 1.5rem;
  }
  .destacado-texto { flex: 1 1 420px; }
  .etiqueta-destacado {
    display: block; color: var(--acento-oscuro); font-weight: 700;
    font-size: .78rem; text-transform: uppercase; letter-spacing: .08em;
    margin-bottom: .7rem;
  }
  .destacado h2 {
    margin: 0 0 .6rem; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; line-height: 1.3;
  }
  .destacado h2 a { color: var(--texto); }
  .destacado h2 a:hover { color: var(--acento); text-decoration: none; }
  .destacado .desc { margin: 0; color: var(--suave); font-size: 1.02rem; max-width: 60ch; }
  .destacado-meta {
    flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-start; gap: .7rem;
  }
</style>
