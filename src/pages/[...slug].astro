---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, categoriaDe } from '../consts';

export async function getStaticPaths() {
  // En dev se sirven también los borradores; en producción, solo draft: false.
  const posts = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat(SITE.idioma, { dateStyle: 'long' });
const cat = categoriaDe(post.data.tags);

// Datos estructurados (SEO): ficha de artículo para Google
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: SITE.nombre, url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: SITE.nombre },
  mainEntityOfPage: new URL(`/${post.id}/`, Astro.site).href,
};

// FAQPage (SEO): si el artículo tiene una sección "## Preguntas frecuentes"
// con pares **pregunta** / respuesta, se extrae del markdown en bruto para
// generar el schema — no requiere tocar el frontmatter de los artículos.
function extraerFAQ(markdown: string) {
  const bloque = markdown.match(/##\s*Preguntas frecuentes\s*\n+([\s\S]*?)(?=\n##\s|$)/i)?.[1];
  if (!bloque) return [];
  return [...bloque.matchAll(/\*\*(.+?)\*\*\s*\n+(.+?)(?=\n\*\*|\n##|$)/gs)]
    .map(([, pregunta, respuesta]) => ({
      pregunta: pregunta.trim(),
      // enlaces markdown → solo el texto ancla; sin negritas sueltas
      respuesta: respuesta.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/\*\*/g, '').trim(),
    }))
    .filter((f) => f.pregunta && f.respuesta);
}
const faq = extraerFAQ(post.body ?? '');
const faqJsonLd = faq.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ pregunta, respuesta }) => ({
    '@type': 'Question',
    name: pregunta,
    acceptedAnswer: { '@type': 'Answer', text: respuesta },
  })),
};
---
<Base title={post.data.title} description={post.data.description} ogImage={`/og/${post.id}.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <main>
    <article class="prosa">
      <header class="post">
        <nav class="migas" aria-label="Ruta">
          <a href="/">Inicio</a>
          {cat && <> &rsaquo; <a href={`/categoria/${cat.id}/`}>{cat.nombre}</a></>}
        </nav>
        <h1>{post.data.title}</h1>
        <p class="meta">
          Publicado el {fmt.format(post.data.pubDate)}
          {post.data.updatedDate && ` · Actualizado el ${fmt.format(post.data.updatedDate)}`}
          {post.data.draft && <span class="badge-borrador">Borrador</span>}
        </p>
      </header>
      <AdSlot />
      <Content />
      <AdSlot />
    </article>
  </main>
</Base>
