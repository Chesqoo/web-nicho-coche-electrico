---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/fraunces/500-italic.css';
import '@fontsource/fraunces/600.css';
import { SITE, CATEGORIAS } from '../consts';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = SITE.descripcion, ogImage = '/og-default.svg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
// Inicial del nombre del sitio para el monograma del logo (evita un icono
// genérico de "rayo/energía" tipo plantilla SaaS: el logotipo es tipográfico).
const inicialLogo = SITE.nombre.trim().charAt(0).toUpperCase();
---
<!doctype html>
<html lang={SITE.idioma}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.adsenseClient && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
      crossorigin="anonymous"
    ></script>
  )}
  <style is:global>
    /* ============================================================
       TOKENS — reglas duras anti "efecto IA". No las relajes al
       pedirle cambios a un asistente; son las que evitan que el
       sitio vuelva a parecer una plantilla genérica:
       - Un único acento de color (verde). Nada de gradientes
         decorativos ni "glow"/neon sobre fondo oscuro.
       - --radius máximo 8px en toda la web (nada de 16px+ "SaaS 2025").
       - Como mucho una sombra sutil, solo en hover de tarjetas.
       - Tipografía con carácter: serif editorial en titulares
         (Fraunces) + sans humanista en cuerpo (Public Sans).
         Cero Inter.
       ============================================================ */
    :root {
      --bg: #fafcfb;
      --texto: #263238;
      --suave: #64748b;
      --acento: #047857;
      --acento-suave: #d8f0e4;
      --acento-oscuro: #065f46;
      --borde: #e2e8e5;
      --card: #ffffff;
      --oscuro: #182420;
      --ancho: 1080px;
      --ancho-prosa: 720px;
      --radius: 8px;
      --serif: 'Fraunces', Georgia, 'Times New Roman', serif;
      --sans: 'Public Sans', system-ui, -apple-system, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: var(--sans);
      color: var(--texto);
      background: var(--bg);
      line-height: 1.75;
      font-size: 1.02rem;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--acento); text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; height: auto; border-radius: var(--radius); }
    h1, h2, h3 { font-family: var(--serif); }

    /* ---------- header ---------- */
    header.site {
      position: sticky; top: 0; z-index: 50;
      background: rgba(250, 252, 251, .95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--borde);
    }
    header.site .inner {
      max-width: var(--ancho); margin: 0 auto;
      padding: .8rem 1.25rem;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    }
    a.logo {
      display: flex; align-items: center; gap: .55rem;
      font-family: var(--serif); font-weight: 600; font-size: 1.2rem; letter-spacing: -.01em;
      color: var(--texto); white-space: nowrap; flex-shrink: 0;
    }
    a.logo:hover { text-decoration: none; }
    .logo-mark {
      width: 32px; height: 32px; border-radius: var(--radius); flex-shrink: 0;
      background: var(--acento); color: #fff;
      display: grid; place-items: center;
      font-family: var(--serif); font-weight: 600; font-size: 1.05rem;
    }
    header.site nav { display: flex; gap: 1.5rem; }
    header.site nav a {
      position: relative;
      color: var(--suave); font-size: .92rem; font-weight: 600; white-space: nowrap;
      padding-bottom: .15rem;
    }
    header.site nav a::after {
      content: ''; position: absolute; left: 0; right: 100%; bottom: 0;
      height: 2px; background: var(--acento);
      transition: right .18s ease;
    }
    header.site nav a:hover { color: var(--acento); text-decoration: none; }
    header.site nav a:hover::after { right: 0; }
    .menu-btn {
      display: none;
      background: none; border: 1px solid var(--borde); border-radius: var(--radius);
      width: 40px; height: 40px; cursor: pointer; color: var(--texto);
      place-items: center; flex-shrink: 0;
    }

    /* móvil: menú colapsado en hamburguesa */
    @media (max-width: 719px) {
      .menu-btn { display: grid; }
      header.site nav {
        display: none;
        position: absolute; top: 100%; left: 0; right: 0;
        flex-direction: column; gap: 0;
        background: var(--bg);
        border-bottom: 1px solid var(--borde);
        box-shadow: 0 14px 24px rgba(24, 36, 32, .08);
        padding: .4rem 1.25rem .8rem;
      }
      header.site nav.abierto { display: flex; }
      header.site nav a {
        padding: .7rem 0; font-size: 1rem;
        border-bottom: 1px solid var(--borde);
      }
      header.site nav a:last-child { border-bottom: none; }
    }

    /* ---------- hero ---------- */
    .hero {
      max-width: var(--ancho); margin: 0 auto;
      padding: 3.5rem 1.25rem 2.5rem;
    }
    .hero-compacto { padding-bottom: 1rem; }
    .hero-compacto h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); }
    .eyebrow {
      display: inline-block; color: var(--acento); font-weight: 700;
      font-size: .8rem; text-transform: uppercase; letter-spacing: .12em;
      margin-bottom: .9rem;
    }
    .hero h1 {
      font-size: clamp(2.1rem, 5vw, 3.2rem);
      font-weight: 600; letter-spacing: -.01em;
      line-height: 1.2; margin: 0 0 .8rem;
    }
    .hero h1 em {
      font-style: italic; font-weight: 500; color: var(--acento-oscuro);
    }
    .hero p { color: var(--suave); font-size: 1.15rem; max-width: 46ch; margin: 0; }

    /* enlaces rápidos a las categorías bajo el hero: navegación real, no relleno */
    .hero-categorias {
      display: grid; gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      margin-top: 2rem;
    }
    .hero-categorias a {
      display: block; color: var(--texto);
      border-top: 1px solid var(--borde); padding-top: .8rem;
    }
    .hero-categorias a:hover { text-decoration: none; }
    .hero-categorias .nombre-cat {
      font-family: var(--serif); font-weight: 600; font-size: 1.05rem;
      color: var(--acento-oscuro);
    }
    .hero-categorias .nombre-cat:hover { text-decoration: underline; }
    .hero-categorias p {
      color: var(--suave); font-size: .88rem; margin: .3rem 0 0; max-width: none;
    }

    /* ---------- grid de tarjetas ---------- */
    main { flex: 1; max-width: var(--ancho); margin: 0 auto; padding: 0 1.25rem 4rem; width: 100%; }
    .seccion-titulo {
      font-size: 1.05rem; font-weight: 800; text-transform: uppercase;
      letter-spacing: .08em; color: var(--suave); margin: 2.2rem 0 0;
    }
    .grid {
      display: grid; gap: 1.3rem;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      margin-top: 1.5rem;
    }
    .lista { max-width: var(--ancho-prosa); margin-top: 1rem; }
    article.card {
      background: var(--card);
      border: 1px solid var(--borde);
      border-radius: var(--radius);
      padding: 1.5rem 1.5rem 1.3rem;
      display: flex; flex-direction: column;
      transition: box-shadow .18s ease, border-color .18s ease;
    }
    article.card:hover {
      border-color: var(--acento);
      box-shadow: 0 4px 16px rgba(24, 36, 32, .06);
    }
    article.card h2 {
      font-family: var(--serif); margin: .7rem 0 .35rem;
      font-size: 1.22rem; line-height: 1.35; font-weight: 600;
    }
    article.card h2 a { color: var(--texto); }
    article.card h2 a:hover { color: var(--acento); text-decoration: none; }
    article.card p { margin: 0 0 .8rem; color: var(--suave); font-size: .95rem; flex: 1; }
    article.card p.desc {
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-cta { font-size: .88rem; font-weight: 700; margin-top: .9rem; }
    .card-cta:hover { text-decoration: none; }
    /* etiqueta de categoría: texto en small-caps, sin fondo de píldora */
    .chip {
      display: inline-block; width: fit-content;
      color: var(--acento-oscuro);
      font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    }
    a.chip:hover { color: var(--acento); text-decoration: underline; }
    .meta { color: var(--suave); font-size: .82rem; }
    .badge-borrador {
      display: inline-block; background: #fee2e2; color: #b91c1c;
      font-size: .68rem; font-weight: 700; padding: .15rem .5rem;
      border-radius: 6px; vertical-align: middle; margin-left: .4rem;
      text-transform: uppercase; letter-spacing: .04em;
    }

    /* ---------- artículo ---------- */
    .prosa { max-width: var(--ancho-prosa); margin: 0 auto; padding-top: 2.5rem; }
    .prosa header.post { margin-bottom: 2rem; }
    .migas { font-size: .85rem; color: var(--suave); margin-bottom: .3rem; }
    .migas a { color: var(--suave); font-weight: 600; }
    .migas a:hover { color: var(--acento); }
    .prosa h1 {
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      font-weight: 600; letter-spacing: -.01em; line-height: 1.25;
      margin: .6rem 0 .7rem;
    }
    .prosa h2 {
      font-size: 1.55rem; font-weight: 600; letter-spacing: 0;
      margin: 2.6rem 0 .9rem; padding-bottom: .5rem;
      position: relative;
    }
    .prosa h2::after {
      content: ''; position: absolute; left: 0; bottom: 0;
      width: 2.5rem; height: 3px; background: var(--acento);
    }
    .prosa h3 { font-size: 1.2rem; font-weight: 600; margin: 2rem 0 .6rem; }
    .prosa table {
      width: 100%; border-collapse: collapse; margin: 1.4rem 0;
      font-size: .95rem; background: #fff;
      border: 1px solid var(--borde); border-radius: var(--radius); overflow: hidden;
      display: block; overflow-x: auto;
    }
    .prosa th {
      background: #eef6f1; text-align: left; font-weight: 700;
      padding: .65rem .9rem; border-bottom: 2px solid var(--borde);
    }
    .prosa td { padding: .6rem .9rem; border-bottom: 1px solid var(--borde); }
    .prosa tr:last-child td { border-bottom: none; }
    .prosa tr:nth-child(even) td { background: #f6faf7; }
    .prosa blockquote {
      margin: 1.5rem 0; padding: .8rem 1.2rem;
      background: var(--acento-suave);
      border-radius: var(--radius); color: var(--acento-oscuro);
    }
    .prosa li { margin-bottom: .4rem; }
    .prosa strong { color: var(--oscuro); }
    /* enlaces dentro de párrafos: no pueden depender solo del color (WCAG) */
    .prosa p a, .prosa li a, .prosa td a { text-decoration: underline; text-underline-offset: 2px; }

    .ad-slot { margin: 2.2rem auto; text-align: center; min-height: 90px; max-width: var(--ancho-prosa); }

    a:focus-visible, button:focus-visible {
      outline: 3px solid var(--acento); outline-offset: 2px; border-radius: 4px;
    }

    /* ---------- footer ---------- */
    footer.site {
      background: var(--oscuro); color: #cfd8d3;
      margin-top: 4rem; font-size: .9rem;
    }
    footer.site .inner {
      max-width: var(--ancho); margin: 0 auto;
      padding: 2.2rem 1.25rem;
      display: flex; flex-wrap: wrap; gap: 1.5rem;
      align-items: center; justify-content: space-between;
    }
    footer.site nav { display: flex; flex-wrap: wrap; gap: 1.2rem; }
    footer.site nav a { color: #cfd8d3; }
    footer.site nav a:hover { color: #6ee7b7; }
    footer.site .marca {
      font-family: var(--serif); font-weight: 600; font-size: 1.05rem;
      color: #fff; display: flex; align-items: center; gap: .6rem;
    }
    .marca-mark {
      width: 24px; height: 24px; border-radius: var(--radius); flex-shrink: 0;
      background: var(--acento); color: #fff;
      display: grid; place-items: center;
      font-size: .85rem;
    }
    footer.site p { margin: .2rem 0 0; color: #93a29b; font-size: .82rem; }
  </style>
</head>
<body>
  <header class="site">
    <div class="inner">
      <a class="logo" href="/">
        <span class="logo-mark" aria-hidden="true">{inicialLogo}</span>
        <span>{SITE.nombre}</span>
      </a>
      <button class="menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-principal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
      <nav id="menu-principal" aria-label="Categorías">
        {CATEGORIAS.map((c) => (
          <a href={`/categoria/${c.id}/`}>{c.nombre}</a>
        ))}
      </nav>
    </div>
  </header>
  <slot />
  <footer class="site">
    <div class="inner">
      <div>
        <div class="marca">
          <span class="marca-mark" aria-hidden="true">{inicialLogo}</span>
          {SITE.nombre}
        </div>
        <p>{SITE.footerFrase}</p>
        <p>© {new Date().getFullYear()} {SITE.nombre}. Información divulgativa: verifica siempre normativa y precios vigentes.</p>
      </div>
      <nav>
        <a href="/sobre/">Sobre nosotros</a>
        <a href="/aviso-legal/">Aviso legal</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/cookies/">Cookies</a>
      </nav>
    </div>
  </footer>
  <script>
    const btn = document.querySelector('.menu-btn');
    const nav = document.getElementById('menu-principal');
    btn?.addEventListener('click', () => {
      const abierto = nav!.classList.toggle('abierto');
      btn.setAttribute('aria-expanded', String(abierto));
      btn.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    });
  </script>
</body>
</html>
