{
  // Configuración de despliegue en Cloudflare Workers (static assets).
  // La web se sirve desde ./dist tras `npm run build`.
  "name": "web-nicho-energia-hogar",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist"
  },
  // Observabilidad: sincronizado con los ajustes del dashboard para
  // que los deploys no los sobrescriban.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
